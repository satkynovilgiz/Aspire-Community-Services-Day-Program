# Copy this file to .env.local for local development, and add the same
# variable in Vercel: Project Settings -> Environment Variables.
#
# Used by app/api/contact/route.js to email contact form submissions to
# jgwanan@aol.com, sent from a Gmail account via an "app password" (not
# your normal Gmail password). To generate one:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an app password: https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app)
#   3. Paste the 16-character password below (no spaces)

GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Admin panel (/admin) ---
# Single admin account. Generate the password hash with:
#   node scripts/hash-password.js "your-new-password"
# IMPORTANT: bcrypt hashes contain "$" characters, and Next.js expands
# "$VAR"-style references in .env files. Escape every "$" as "\$" below,
# or the value will get silently mangled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Random string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
