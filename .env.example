# Copy this file to .env.local for local development, and add the same
# variable in Vercel: Project Settings -> Environment Variables.
#
# Used by app/api/contact/route.js to email contact form submissions to
# jgwanan@aol.com via Resend (https://resend.com). Create an API key at
# https://resend.com/api-keys — the free tier is enough for this volume.

RESEND_API_KEY=

# --- Admin panel (/admin) ---
# Single admin account. Generate the password hash with:
#   node scripts/hash-password.js "your-new-password"
# IMPORTANT: bcrypt hashes contain "$" characters, and Next.js expands
# "$VAR"-style references in .env files. Escape every "$" as "\$" below,
# or the value will get silently mangled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Random string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
